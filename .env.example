# Executive API (server only). Leave credentials blank to run on labeled demo data.
# Never prefix these with NEXT_PUBLIC_. Never commit a real key or password.
SUBHUB_API_BASE_URL=https://app.subcontractorhub.com
# auto | login | bearer | basic | basic+key
# auto with a username and password uses Sanctum login. Basic is not used:
# the API answers Basic with the HTML login page.
SUBHUB_AUTH_MODE=auto
SUBHUB_API_KEY=
# Platform user email for the Executive Leadership Read Only role.
SUBHUB_API_USERNAME=
SUBHUB_API_PASSWORD=
# Header used only when SUBHUB_AUTH_MODE=basic+key.
SUBHUB_API_KEY_HEADER=X-API-Key
# Leave blank to try /api/login, /api/v1/login, and /api/auth/login.
# Set this to try that path first.
SUBHUB_LOGIN_PATH=
SUBHUB_LOGIN_USERNAME_FIELD=email
SUBHUB_LOGIN_PASSWORD_FIELD=password
# Optional. Blank omits the field. The documented login body is {email, password}.
SUBHUB_LOGIN_KEY_FIELD=
SUBHUB_LOGIN_DEVICE_NAME=

# Optional placeholder auth until Google SSO. When unset, the app is open
# and shows a banner. Set this in Vercel for any shared deployment.
DASHBOARD_PASSWORD=

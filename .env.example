# Executive API (server only). Leave credentials blank to run on labeled demo data.
# Never prefix these with NEXT_PUBLIC_. Never commit a real key or password.
SUBHUB_API_BASE_URL=https://app.subcontractorhub.com
# auto | bearer | basic | basic+key | login
# auto uses basic+key, then basic, then bearer. Login is not tried unless SUBHUB_LOGIN_PATH is set.
SUBHUB_AUTH_MODE=auto
SUBHUB_API_KEY=
SUBHUB_API_USERNAME=
SUBHUB_API_PASSWORD=
# Header used for the key when mode is basic+key. One Authorization header cannot carry both.
SUBHUB_API_KEY_HEADER=X-API-Key
# Optional Sanctum fallback. Leave the path blank to disable it.
# When SUBHUB_AUTH_MODE=login and this is blank, the path defaults to /api/login.
SUBHUB_LOGIN_PATH=
SUBHUB_LOGIN_USERNAME_FIELD=email
SUBHUB_LOGIN_PASSWORD_FIELD=password
SUBHUB_LOGIN_KEY_FIELD=key
SUBHUB_LOGIN_DEVICE_NAME=cxm-dashboard

# Optional placeholder auth until Google SSO. When unset, the app is open
# and shows a banner. Set this in Vercel for any shared deployment.
DASHBOARD_PASSWORD=

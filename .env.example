# Executive API (server only). Leave the key blank to run on labeled demo data.
# Never prefix these with NEXT_PUBLIC_. Never commit a real key.
SUBHUB_API_KEY=
SUBHUB_API_BASE_URL=https://api.virtualsaleportal.com

# Optional placeholder auth until Google SSO. When unset, the app is open
# and shows a banner. Set this in Vercel for any shared deployment.
DASHBOARD_PASSWORD=
